# Khi chạy bằng Docker Compose (khuyên dùng), KHÔNG cần sửa DATABASE_URL —
# docker-compose.yml đã tự set biến này trỏ tới container Postgres "db".
# Giá trị dưới đây chỉ dùng khi bạn chạy Postgres riêng / chạy npm run dev không qua Docker.
DATABASE_URL="postgresql://app:app@localhost:5432/real_estate?schema=public"

# Đổi thành chuỗi ngẫu nhiên mạnh khi deploy thật, vd: openssl rand -base64 32
NEXTAUTH_SECRET="doi-chuoi-nay-thanh-random-string-that-manh"
NEXTAUTH_URL="http://localhost:3000"

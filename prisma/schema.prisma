generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  phone                 String?
  passwordHash          String
  role                  Role               @default(CUSTOMER)
  avatarUrl             String?
  referralCode          String?            @unique
  active                Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  referredCollaborators Collaborator[]     @relation("ReferredByStaff")
  collaboratorProfile   Collaborator?      @relation("CollaboratorUser")
  assignedCustomers     Customer[]         @relation("AssignedStaff")
  customerActivities    CustomerActivity[] @relation("ActivityAuthor")
  favorites             Favorite[]
  listings              Listing[]          @relation("ListingAuthor")
  news                  News[]             @relation("NewsAuthor")
  projects              Project[]          @relation("ProjectAuthor")
}

model Province {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  customers Customer[]
  districts District[]
  listings  Listing[]
  projects  Project[]
}

model District {
  id         String     @id @default(cuid())
  name       String
  slug       String
  provinceId String
  customers  Customer[]
  province   Province   @relation(fields: [provinceId], references: [id])
  listings   Listing[]
  projects   Project[]

  @@unique([provinceId, slug])
}

model Project {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  developer         String?
  description       String?
  address           String?
  provinceId        String?
  districtId        String?
  thumbnail         String?
  images            String?
  isActive          Boolean            @default(true)
  featured          Boolean            @default(false)
  authorId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customers         Customer[]
  customerInquiries CustomerInquiry[]
  listings          Listing[]
  author            User?              @relation("ProjectAuthor", fields: [authorId], references: [id])
  district          District?          @relation(fields: [districtId], references: [id])
  province          Province?          @relation(fields: [provinceId], references: [id])
  inventories       ProjectInventory[]
  resources         ProjectResource[]
  website           ProjectWebsite?
}

model ProjectResource {
  id          String              @id @default(cuid())
  projectId   String?
  type        ProjectResourceType @default(OTHER)
  title       String
  url         String
  description String?
  isActive    Boolean             @default(true)
  isPublic    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([isActive, isPublic])
}

model Listing {
  id                 String            @id @default(cuid())
  unitCode           String            @unique
  title              String
  slug               String            @unique
  projectId          String?
  block              String?
  floor              String?
  address            String?
  provinceId         String?
  districtId         String?
  transactionType    TransactionType
  salePrice          Float?
  rentPrice          Float?
  propertyType       PropertyType
  area               Float
  bedrooms           Int?
  bathrooms          Int?
  doorDirection      Direction?
  balconyDirection   Direction?
  view               String?
  furnitureStatus    FurnitureStatus?
  legalStatus        LegalStatus?
  unitStatus         UnitStatus        @default(CHO_DUYET)
  description        String?
  images             String?
  verified           Boolean           @default(false)
  viewCount          Int               @default(0)
  authorId           String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  productCode        String?           @unique
  customerActivities Customer[]        @relation("InterestedListing")
  customerInquiries  CustomerInquiry[] @relation("InterestedListingInquiries")
  favorites          Favorite[]
  author             User              @relation("ListingAuthor", fields: [authorId], references: [id])
  district           District?         @relation(fields: [districtId], references: [id])
  project            Project?          @relation(fields: [projectId], references: [id])
  province           Province?         @relation(fields: [provinceId], references: [id])

  @@index([transactionType, propertyType, unitStatus])
  @@index([provinceId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  thumbnail   String?
  content     String
  authorId    String
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  category    String?
  summary     String?
  tags        String?
  metaTitle   String?
  ogImage     String?
  publishedAt DateTime?
  focusKeyword String?
  author      User      @relation("NewsAuthor", fields: [authorId], references: [id])
}

model Collaborator {
  id                  String             @id @default(cuid())
  fullName            String
  phone               String             @unique
  email               String?
  publicReferralToken String             @unique
  status              CollaboratorStatus @default(ACTIVE)
  userId              String?            @unique
  referredByUserId    String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  referredByUser      User               @relation("ReferredByStaff", fields: [referredByUserId], references: [id])
  user                User?              @relation("CollaboratorUser", fields: [userId], references: [id])
  assignedCustomers   Customer[]         @relation("AssignedCollaborator")
  inquiries           CustomerInquiry[]  @relation("InquiryCollaborator")

  @@index([referredByUserId])
  @@index([publicReferralToken])
}

model Customer {
  id                     String             @id @default(cuid())
  fullName               String
  phone                  String             @unique
  email                  String?
  source                 LeadSource         @default(WEBSITE)
  demandType             DemandType         @default(TU_VAN)
  propertyTypeInterest   PropertyType?
  areaInterest           String?
  budgetFrom             Float?
  budgetTo               Float?
  projectId              String?
  provinceId             String?
  districtId             String?
  interestedListingId    String?
  status                 LeadStatus         @default(MOI)
  assignedToId           String?
  nextFollowUpAt         DateTime?
  note                   String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  assignedAt             DateTime?
  assignedCollaboratorId String?
  assignedCollaborator   Collaborator?      @relation("AssignedCollaborator", fields: [assignedCollaboratorId], references: [id])
  assignedTo             User?              @relation("AssignedStaff", fields: [assignedToId], references: [id])
  district               District?          @relation(fields: [districtId], references: [id])
  interestedListing      Listing?           @relation("InterestedListing", fields: [interestedListingId], references: [id])
  project                Project?           @relation(fields: [projectId], references: [id])
  province               Province?          @relation(fields: [provinceId], references: [id])
  activities             CustomerActivity[]
  inquiries              CustomerInquiry[]

  @@index([status])
  @@index([assignedToId])
  @@index([assignedCollaboratorId])
}

model CustomerInquiry {
  id             String        @id @default(cuid())
  customerId     String
  source         LeadSource    @default(WEBSITE)
  demandType     DemandType    @default(TU_VAN)
  note           String?
  projectId      String?
  listingId      String?
  collaboratorId String?
  pageUrl        String?
  referrerUrl    String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime      @default(now())
  collaborator   Collaborator? @relation("InquiryCollaborator", fields: [collaboratorId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listing        Listing?      @relation("InterestedListingInquiries", fields: [listingId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])

  @@index([customerId])
  @@index([collaboratorId])
  @@index([createdAt])
}

model CustomerActivity {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  type       String
  content    String
  createdAt  DateTime @default(now())
  author     User     @relation("ActivityAuthor", fields: [authorId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
}

model ProjectInventory {
  id               String           @id @default(cuid())
  projectId        String
  unitCode         String
  block            String?
  floor            String?
  salePrice        Float?
  bedrooms         Int?
  bathrooms        Int?
  area             Float
  doorDirection    Direction?
  balconyDirection Direction?
  furnitureStatus  FurnitureStatus?
  unitStatus       UnitStatus       @default(DANG_BAN)
  description      String?
  images           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, unitCode])
  @@index([projectId])
  @@index([projectId, block])
  @@index([projectId, unitStatus])
}

model ProjectWebsite {
  id                       String        @id @default(cuid())
  projectId                String        @unique
  status                   WebsiteStatus @default(DRAFT)
  draftSectionsConfig      String?
  draftContentJson         String?
  draftMetaTitle           String?
  draftMetaDescription     String?
  draftOgImage             String?
  publishedSectionsConfig  String?
  publishedContentJson     String?
  publishedMetaTitle       String?
  publishedMetaDescription String?
  publishedOgImage         String?
  publishedAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  project                  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  COLLABORATOR_PRO
  CUSTOMER
}

enum TransactionType {
  SALE
  RENT
}

enum PropertyType {
  CAN_HO
  OFFICETEL
  CONDOTEL
  PENTHOUSE
  DUPLEX
  SHOPHOUSE_KHOI_DE
  NHA_LIEN_KE
  DAT_NEN
  SHOPHOUSE_LIEN_KE
  BIET_THU_SONG_LAP
  BIET_THU_DON_LAP
  NHA_PHO
  DAT_NEN_DU_AN
  DAT_THO_CU
}

enum Direction {
  DONG
  TAY
  NAM
  BAC
  DONG_NAM
  TAY_NAM
  TAY_BAC
  DONG_BAC
}

enum FurnitureStatus {
  FULL_NOI_THAT
  CO_BAN
  BAN_GIAO_THO
  CAN_TRONG
}

enum LegalStatus {
  SO_DO_HONG
  HOP_DONG_MUA_BAN
  DANG_CHO_SO
  VI_BANG
}

enum UnitStatus {
  DANG_BAN
  DANG_CHO_THUE
  DA_BAN
  DA_CHO_THUE
  TAM_NGUNG
  CHO_DUYET
}

enum LeadSource {
  WEBSITE
  HOTLINE
  ZALO
  FACEBOOK
  GIOI_THIEU
  KY_GUI
  KHAC
  LISTING
  PROJECT
  FOOTER
  CONTACT
  CONSIGNMENT
  DIRECT
  CTV
}

enum DemandType {
  MUA
  THUE
  KY_GUI_BAN
  KY_GUI_CHO_THUE
  TU_VAN
}

enum LeadStatus {
  MOI
  DANG_LIEN_HE
  DA_HEN_GAP
  DA_CHOT
  KHONG_TIEM_NANG
  DONG
}

enum CollaboratorStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum ProjectResourceType {
  WEBSITE
  TOUR_360
  GENERAL_INFO
  DRIVER_TT
  PRICE_LIST
  SALES_POLICY
  FLOOR_PLAN
  BROCHURE
  LEGAL
  PROGRESS
  VIDEO
  DESIGN_FILE
  IMAGE
  GOOGLE_DRIVE
  OTHER
}

enum WebsiteStatus {
  DRAFT
  PUBLISHED
}
